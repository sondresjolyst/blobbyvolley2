#include <winver.h>
#include "ForkVersion.h"

MAINICON ICON "icon.ico"

#if BLOBBY_RC_TARGET == 2
#define BLOBBY_RC_DESCRIPTION "Blobby Volley JulaLAN server"
#define BLOBBY_RC_NAME "blobby-server"
#define BLOBBY_RC_FILENAME "blobby-server.exe"
#elif BLOBBY_RC_TARGET == 3
#define BLOBBY_RC_DESCRIPTION "Blobby Volley JulaLAN load test bot"
#define BLOBBY_RC_NAME "blobby-loadbot"
#define BLOBBY_RC_FILENAME "blobby-loadbot.exe"
#else
#define BLOBBY_RC_DESCRIPTION "Blobby Volley JulaLAN"
#define BLOBBY_RC_NAME "blobby"
#define BLOBBY_RC_FILENAME "blobby.exe"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION BLOBBY_FORK_VERSION_MAJOR, BLOBBY_FORK_VERSION_MINOR, BLOBBY_FORK_VERSION_PATCH, 0
PRODUCTVERSION BLOBBY_FORK_VERSION_MAJOR, BLOBBY_FORK_VERSION_MINOR, BLOBBY_FORK_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "JulaLAN"
			VALUE "FileDescription", BLOBBY_RC_DESCRIPTION
			VALUE "FileVersion", BLOBBY_FORK_VERSION
			VALUE "InternalName", BLOBBY_RC_NAME
			VALUE "LegalCopyright", "Blobby Volley 2 authors, GPL-2.0-or-later"
			VALUE "OriginalFilename", BLOBBY_RC_FILENAME
			VALUE "ProductName", "Blobby Volley JulaLAN"
			VALUE "ProductVersion", BLOBBY_FORK_VERSION
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
