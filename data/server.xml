<?xml version="1.0" encoding="utf-8"?>

<userconfig>
	<var name="speeds" value="30 60 75 90 120"/>
	<var name="port" value="1234"/>
	<var name="maximum_clients" value="100" />
	<var name="name" value="Blobby Volley 2 Server"/>
	<var name="description" value="replace this with a description of the server. To do this, edit data/server.xml"/>
	<var name="rules" value="default.lua classic.lua back_defence.lua one_hit_wonder.lua the_double.lua blitz.lua firewall.lua sticky_mode.lua jumping_jack.lua tennis.lua"/>
	<!-- In tournament mode players type their join code as name. The server swaps it for the nickname in the players file and refuses unknown codes. -->
	<var name="tournament_mode" value="false"/>
	<!-- Players file of tournament mode. A relative path starts in the working directory of the server. -->
	<var name="tournament_players_file" value="tournament_players.xml"/>
	<!-- Most assigned matches that play at the same time in tournament mode. 1 plays one match at a time, 0 means no limit. -->
	<var name="tournament_max_matches" value="0"/>
	<!-- Seconds between two games of a series, 3 to 120. A match in the players file can set its own with nextGameDelay. -->
	<var name="tournament_next_game_delay" value="10"/>
	<!-- Each finished game and series is added to this file as a line of JSON. Leave it empty to only log them. -->
	<var name="tournament_results_file" value="tournament_results.jsonl"/>
	<!-- Folder for the players file, the results and the reports that wait for the site. Empty means the working directory. BLOBBY_DATA_DIR comes first. -->
	<var name="tournament_data_dir" value=""/>
	<!-- Address of the tournament site, https only. The server then reads the players file from the site and reports each game. BLOBBY_SITE_URL comes first. -->
	<var name="tournament_site_url" value=""/>
	<!-- Game server token from the admin page of the site. Prefer BLOBBY_SITE_TOKEN, which comes first. -->
	<var name="tournament_site_token" value=""/>
</userconfig>
